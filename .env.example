DATABASE_URL=postgres://cms:cms@localhost:5433/cms
BIND_ADDR=127.0.0.1:3000
# Origin'ы Vue-фронта через запятую; * — любой
CORS_ORIGINS=http://localhost:5173
TEMPLATES_DIR=templates
STATIC_DIR=static
# Загруженные файлы, отдаются по /upload/
UPLOAD_DIR=upload
# Откуда докачивать отсутствующие /upload/* (старый сайт на Битриксе); пусто — не докачивать
UPLOAD_ORIGIN_URL=
# Почта: smtp://user:pass@host:587 (smtps:// — TLS). Пусто — берутся настройки из админки («Настройки сайта»), а если и там пусто — письма сохраняются в MAIL_DIR.
# Значение этой переменной важнее настроек в БД.
MAIL_SMTP_URL=
MAIL_DIR=mail
# true — только за HTTPS
COOKIE_SECURE=false
# Заменяет схему и хост банков курсов валют (ЦБ, НБУ, НБРБ); пусто — настоящие адреса
CURRENCY_BANK_URL=
# Проверка CSRF на POST bxapi; false — только для отладки
CSRF_ENFORCE=true
# Лимит запросов публичного API на IP в минуту; 0 — выключено
RATE_LIMIT_PER_MIN=600
RUST_LOG=cms=debug,tower_http=info,sqlx=warn
# Инструменты супер-администратора (SQL, таблицы БД, Rust-скрипты); 0 — страницы 404
ADMIN_TOOLS_ENABLED=1
# Общий каталог сборки Rust-скриптов (относительно каталога проекта или абсолютный)
RUST_SCRIPT_TARGET_DIR=target/rust-scripts
# Таймауты сборки и запуска Rust-скриптов, секунды
RUST_SCRIPT_BUILD_TIMEOUT=180
RUST_SCRIPT_RUN_TIMEOUT=30
